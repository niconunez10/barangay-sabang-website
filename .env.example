# Copy to .env; never commit production secrets.
# These first settings are for the Flask website. Its AI chat needs no API keys.
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# The following settings are for the separate Messenger service only.
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=replace-with-a-random-webhook-verification-token
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v22.0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
ANNOUNCEMENTS_FEED_PATH=messenger_backend/data/announcements.json

DUTY_DESK_WEBHOOK_URL=
DUTY_DESK_WEBHOOK_SECRET=
NER_MODEL=en_core_web_sm

# Configure the actual local outpost number; do not use a placeholder in production.
BARANGAY_TANOD_PHONE=
BFP_HOTLINE=911
PNP_HOTLINE=911

CURRENT_EVENT_MAX_AGE_DAYS=7
TRUSTED_SEARCH_DOMAINS=gov.ph,pagasa.dost.gov.ph,pna.gov.ph,gmanetwork.com,abs-cbn.com,inquirer.net,philstar.com,rappler.com
